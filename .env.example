# ElevenLabs Agent ID (from your ElevenLabs dashboard)
VITE_ELEVENLABS_AGENT_ID=your_agent_id_here

# Vision API — follows OpenAI chat/completions format with image_url
# Default provider: Groq (free, 30 RPM) — get a key at https://console.groq.com
VITE_VISION_API_KEY=your_groq_api_key_here

# Optional overrides (defaults work with Groq free tier):
# VITE_VISION_BASE_URL=https://api.groq.com/openai/v1
# VITE_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# To use OpenAI instead:
# VITE_VISION_API_KEY=your_openai_key
# VITE_VISION_BASE_URL=https://api.openai.com/v1
# VITE_VISION_MODEL=gpt-4o-mini

# -- Replicate (AI image generation) ------------------------------------
# Server-only token (no VITE_ prefix) — injected by the Vite dev proxy at
# /api/replicate so the key never reaches the browser bundle.
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# Optional image-model override. Defaults to black-forest-labs/flux-schnell
# (~3s, ~$0.003/image). Other good options:
#   black-forest-labs/flux-1.1-pro   (slower, higher quality)
#   stability-ai/sdxl                 (classic SDXL)
# VITE_REPLICATE_MODEL=black-forest-labs/flux-schnell

# Optional video-model override. Defaults to wan-video/wan-2.2-t2v-fast
# (~40s for 5s @ 480p, ~$0.04/video). Other good options:
#   wavespeedai/wan-2.1-t2v-480p      (older Wan 2.1, similar speed)
#   bytedance/seedance-1-lite          (better quality, ~60s, ~$0.10)
#   kwaivgi/kling-v1.6-standard        (cinematic, ~90s, ~$0.20)
#   minimax/video-01                   (balanced)
# VITE_REPLICATE_VIDEO_MODEL=wan-video/wan-2.2-t2v-fast

# -- Image → 3D (camera object scan) ------------------------------------
# n8n webhook that accepts a multipart/form-data POST with the JPEG bytes in
# a field named "data" and returns a .glb URL (proxies to Tripo image-to-3D).
# Used by the scan_to_3d client tool.

# Defaults to the shared workflow below if unset. The submit endpoint returns
# a job id ({ "id": "27677" }); the app then polls the status endpoint every
# 60s (GET ?jobid=<id>) until the .glb appears in the response's `url` field.
# VITE_N8N_OBJECT_WEBHOOK=https://fxaitools.app.n8n.cloud/webhook/generate-3d-tripo
# VITE_N8N_OBJECT_POLL_WEBHOOK=https://fxaitools.app.n8n.cloud/webhook/generate-3d

# -- Text → 3D (prompt-only object generation) --------------------------
# n8n webhook that accepts a JSON POST { "prompt": "<description>" } and returns
# a job id ({ "id": "27677" }), proxying to Tripo text-to-3D. Used by the
# generate_3d client tool. Polling reuses VITE_N8N_OBJECT_POLL_WEBHOOK above.
# VITE_N8N_OBJECT_TEXT_WEBHOOK=https://fxaitools.app.n8n.cloud/webhook/generate-3d-tripo-text


# Tripo's CDN doesn't send CORS headers, so <model-viewer> can't fetch the .glb
# cross-origin. This n8n webhook re-fetches the model server-side and re-serves
# it WITH CORS headers: GET ?url=<encoded .glb URL> → raw bytes,
# Content-Type: model/gltf-binary, Access-Control-Allow-Origin: *.
# Set to empty to disable proxying (only if the poll `url` is already CORS-safe).
# VITE_N8N_GLB_PROXY_WEBHOOK=https://fxaitools.app.n8n.cloud/webhook/glb-proxy

# -- Face scan & analyze (age / gender / color analysis) ----------------
# Used by the scan_face_analyze client tool ("scan my face and analyze").
#
# By DEFAULT the captured face frame is POSTed as BINARY multipart/form-data
# (field name "image") to the n8n analyze-face workflow below, which returns the
# JSON shape documented in face-analysis-prompt.md ({ "people": [...],
# "summary": "..." }).
#
#   Default endpoint: https://fxaitools.app.n8n.cloud/webhook/analyze-face
#
# Override the endpoint here, or set it to "off" to skip n8n entirely and call
# the OpenAI-compatible Vision API above (VITE_VISION_*) directly from the
# browser instead. See face-analysis-prompt.md for the full n8n / ElevenLabs
# setup.
# VITE_N8N_FACE_ANALYSIS_WEBHOOK=https://fxaitools.app.n8n.cloud/webhook/analyze-face








